<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: install replaces HOME_DIR with $HOME, since launchd does not expand ~. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.knyghty.personal-data-mac.flights</string>
  <key>ProgramArguments</key>
  <array>
    <string>HOME_DIR/.local/bin/personal-data-mac</string>
    <string>--flights</string>
  </array>
  <key>StartInterval</key>
  <integer>60</integer>
  <key>StandardOutPath</key>
  <string>HOME_DIR/Library/Logs/personal-data-mac.log</string>
  <key>StandardErrorPath</key>
  <string>HOME_DIR/Library/Logs/personal-data-mac.log</string>
</dict>
</plist>
