        "url_options": {"method": "POST", "body_type": "raw", "body_content_type": "text/plain",
          "data": "WITH d AS (SELECT wake_date - 1 AS day, bedtime_h AS value FROM sleep_night), r AS (SELECT day, value, avg(value) OVER (ORDER BY day RANGE BETWEEN INTERVAL 6 DAY PRECEDING AND CURRENT ROW) AS avg_7d, avg(value) OVER (ORDER BY day RANGE BETWEEN INTERVAL 27 DAY PRECEDING AND CURRENT ROW) AS avg_28d FROM d) SELECT day::TIMESTAMP AS time, value, avg_7d, avg_28d FROM r WHERE day BETWEEN DATE '${__from:date:YYYY-MM-DD}' AND DATE '${__to:date:YYYY-MM-DD}' ORDER BY 1"},
