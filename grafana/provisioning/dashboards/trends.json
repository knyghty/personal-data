{
  "uid": "trends",
  "title": "Trends",
  "description": "Daily values with 7- and 28-day averages: a 7-day line that stays above or below the 28-day line is a trend.",
  "tags": ["personal-data"],
  "timezone": "Europe/Amsterdam",
  "editable": true,
  "schemaVersion": 41,
  "time": {"from": "now-1y", "to": "now"},
