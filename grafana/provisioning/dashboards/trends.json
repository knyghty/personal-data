  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Sleep (hours asleep)",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "datasource": {"type": "yesoreyeram-infinity-datasource", "uid": "personal"},
      "fieldConfig": {"defaults": {"unit": "h", "decimals": 1, "custom": {"lineWidth": 2, "spanNulls": true}}, "overrides": [{"matcher": {"id": "byName", "options": "daily"}, "properties": [{"id": "custom.drawStyle", "value": "points"}, {"id": "custom.pointSize", "value": 3}, {"id": "color", "value": {"mode": "fixed", "fixedColor": "#8884"}}]}, {"matcher": {"id": "byName", "options": "7-day average"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "blue"}}, {"id": "custom.lineWidth", "value": 1.5}]}, {"matcher": {"id": "byName", "options": "28-day average"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "orange"}}, {"id": "custom.lineWidth", "value": 3}]}]},
      "targets": [{"refId": "A", "datasource": {"type": "yesoreyeram-infinity-datasource", "uid": "personal"}, "type": "json", "source": "url", "format": "table", "parser": "backend", "url": "/sql",
        "url_options": {"method": "POST", "body_type": "raw", "body_content_type": "text/plain",
          "data": "WITH d AS (SELECT wake_date AS day, asleep_h AS value FROM sleep_night), r AS (SELECT day, value, avg(value) OVER (ORDER BY day RANGE BETWEEN INTERVAL 6 DAY PRECEDING AND CURRENT ROW) AS avg_7d, avg(value) OVER (ORDER BY day RANGE BETWEEN INTERVAL 27 DAY PRECEDING AND CURRENT ROW) AS avg_28d FROM d) SELECT day::TIMESTAMP AS time, value, avg_7d, avg_28d FROM r WHERE day BETWEEN DATE '${__from:date:YYYY-MM-DD}' AND DATE '${__to:date:YYYY-MM-DD}' ORDER BY 1"},
        "columns": [{"selector": "time", "text": "time", "type": "timestamp"}, {"selector": "value", "text": "daily", "type": "number"}, {"selector": "avg_7d", "text": "7-day average", "type": "number"}, {"selector": "avg_28d", "text": "28-day average", "type": "number"}]}]
    },
    {
